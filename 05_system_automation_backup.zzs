from std/io import Path;
from std/proc import Proc;
from std/time import Time;

let source := new Path("notes.txt");
let stamp := new Time().strftime("%Y%m%d-%H%M%S");
let backup := new Path("backup-" _ stamp _ ".txt");
source.copy(backup);
let info := Proc.run("wc", ["-l", backup.to_String()], { capture_stdout: true });
say( "Backed up notes to " _ backup.to_String() );
say( "Line count: " _ info.get("stdout", "unknown") );
