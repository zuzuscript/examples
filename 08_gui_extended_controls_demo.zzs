from std/gui import *;

function log ( String message ) {
	say "[gui extended demo] " _ message;
}

let status := Text(
	id: "status",
	value: "Ready. Try the slider, list, tree, tabs, or close button.",
	readonly: true,
	wrap: true,
);

let progress := Progress(
	id: "progress",
	value: 35,
	min: 0,
	max: 100,
	show_text: true,
);

let slider := Slider(
	id: "slider",
	value: 35,
	min: 0,
	max: 100,
	step: 5,
);

let date := DatePicker(
	id: "date",
	value: "2026-04-26",
	min: "2020-01-01",
	max: "2030-12-31",
	first_day_of_week: 1,
);

let tabs := Tabs(
	id: "tabs",
	selected: "overview",
	Tab(
		id: "overview-tab",
		title: "Overview",
		value: "overview",
		Text( value: "Overview tab content", readonly: true ),
	),
	Tab(
		id: "details-tab",
		title: "Details",
		value: "details",
		icon: "examples/gui-demo-image.png",
		Text( value: "Details tab content", readonly: true ),
	),
);

let list := ListView(
	id: "list",
	items: [
		{ label: "Alpha", value: "a" },
		{ label: "Beta", value: "b" },
		{ label: "Gamma", value: "g" },
	],
	selected_index: 0,
);

let tree := TreeView(
	id: "tree",
	multiple: false,
	items: [
		{
			label: "Project",
			value: "project",
			children: [
				{ label: "Source", value: "source" },
				{ label: "Tests", value: "tests" },
			],
		},
		{ label: "Docs", value: "docs" },
	],
	selected_path: [ 0 ],
);

let close_button := Button(
	id: "close",
	text: "Close",
	variant: "primary",
);

let about_item := MenuItem( id: "about-menu-item", text: "About" );
let disabled_save_item := MenuItem(
	id: "save-menu-item",
	text: "Save",
	disabled: true,
);
let quit_item := MenuItem( id: "quit-menu-item", text: "Quit" );

let window := Window(
	title: "Zuzu GUI Extended Controls Demo",
	width: 560,
	height: 640,
	Menu(
		id: "file-menu",
		text: "File",
		disabled_save_item,
		quit_item,
	),
	Menu(
		id: "help-menu",
		text: "Help",
		about_item,
	),
	VBox(
		id: "root",
		padding: 12,
		gap: 8,
		Label( text: "Slider and progress" ),
		slider,
		progress,
		Label( text: "Date" ),
		date,
		Separator(),
		tabs,
		HBox(
			gap: 8,
			Frame( label: "List", list ),
			Frame( label: "Tree", tree ),
		),
		status,
		close_button,
	),
);

slider.change( function () {
	progress.value( slider.value() );
	status.value( "Slider value: " _ slider.value() );
	log( "slider value is " _ slider.value() );
} );

date.change( function () {
	status.value( "Selected date: " _ date.value() );
	log( "selected date is " _ date.value() );
} );

tabs.on( "select", function () {
	status.value( "Selected tab: " _ tabs.selected() );
	log( "selected tab is " _ tabs.selected() );
} );

list.on( "select", function () {
	let item := list.selected_item();
	status.value( "List selected: " _ item{label} );
	log( "list selected: " _ item{label} );
} );

list.activate( function () {
	let item := list.selected_item();
	status.value( "List activated: " _ item{label} );
	log( "list activated: " _ item{label} );
} );

tree.on( "select", function () {
	let item := tree.selected_item();
	status.value( "Tree selected: " _ item{label} );
	log( "tree selected: " _ item{label} );
} );

tree.activate( function () {
	let item := tree.selected_item();
	status.value( "Tree activated: " _ item{label} );
	log( "tree activated: " _ item{label} );
} );

about_item.click( function () {
	status.value("Zuzu GUI demo menu item clicked.");
	log("about menu item clicked");
} );

quit_item.click( function () {
	status.value("Closing from menu.");
	log("quit menu item clicked");
	window.close("closed by menu");
} );

close_button.click( function () {
	status.value("Closing.");
	log("close clicked");
	window.close("closed by button");
} );

log("opening window");
log( "Window result: " _ window.call() );
